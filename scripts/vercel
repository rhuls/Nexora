#!/usr/bin/env bash
# Runs the Vercel CLI in a container, because this machine has no Node installed.
#
# Authentication comes from a token file that never passes through a shell argument
# or a log line: it is read into an environment variable and handed to the container
# as a name, so the value appears in no transcript, no `ps` output and no history.
set -euo pipefail

TOKEN_FILE="${VERCEL_TOKEN_FILE:-$HOME/.vercel-token}"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -f "$TOKEN_FILE" ]]; then
  echo "No token file at $TOKEN_FILE." >&2
  echo "Create one at https://vercel.com/account/tokens, then store it without echoing it:" >&2
  echo '  read -rs TOKEN && printf %s "$TOKEN" > ~/.vercel-token && chmod 600 ~/.vercel-token && unset TOKEN' >&2
  exit 1
fi

VERCEL_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
export VERCEL_TOKEN

# The CLI is baked into an image rather than fetched by npx on each call, so a
# debugging session is a sequence of one-second commands instead of minute-long installs.
if ! docker image inspect nexora-vercel-cli >/dev/null 2>&1; then
  printf 'FROM node:22-alpine\nRUN npm i -g vercel@latest\nENTRYPOINT ["vercel"]\n' \
    | docker build -q -t nexora-vercel-cli - >/dev/null
fi

exec docker run --rm \
  -e VERCEL_TOKEN \
  -v "$REPO:/work" \
  -w /work \
  nexora-vercel-cli "$@"
