# Copy to .env and fill in every value. Generate the password with: openssl rand -hex 24
POSTGRES_USER=nexora
POSTGRES_PASSWORD=
POSTGRES_DB=nexora
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=5173
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# How often the sync worker refreshes current-season (LIVE) fixtures and results. Minimum 5.
LIVE_SYNC_INTERVAL_MINUTES=60
# Optional. API-Football (https://www.api-football.com) key for richer statistics, events, lineups and injuries.
# Leave empty to run on OpenFootball only. Real value goes in .env only — never commit it.
API_FOOTBALL_KEY=
# Nexora's own daily request ceiling (free plan allows 100/day); keeps headroom for manual checks.
API_FOOTBALL_DAILY_BUDGET=90

# Guards every endpoint that writes state or runs heavy computation.
# Required whenever NODE_ENV=production, which includes the Docker stack.
# Generate one with: openssl rand -base64 32
NEXORA_API_TOKEN=<from pass store: nexora/api-token>

# One season imports inside a single transaction. Two minutes suits a local database; a managed
# one across a network needs more, because the cost is round-trips rather than work.
IMPORT_TRANSACTION_TIMEOUT_MS=120000
